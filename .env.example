PORT=5050

# XAMPP MySQL (default root has no password)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=etender_db

# Change both secrets before using anywhere real
JWT_SECRET=change-this-jwt-secret
JWT_EXPIRES_IN=1d
# Key for the reversible TripleDES password encryption (admins can reveal passwords)
PASSWORD_SECRET=change-this-password-secret

# Comma-separated frontend origins
CLIENT_ORIGINS=http://localhost:5173,http://localhost:5174

# Anti-sniping (same as live): a bid with <= N seconds left adds M minutes
AUTO_EXTEND_WINDOW_SECONDS=11
AUTO_EXTEND_MINUTES=5
